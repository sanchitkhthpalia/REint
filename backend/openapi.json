  "info": {
    "description": "Day-ahead wind forecasts available at decision time, and their error against actual generation (Elexon BMRS WINDFOR / FUELHH).",
    "title": "Wind Forecast Monitor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/meta": {
      "get": {
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Meta"
      }
    },
    "/api/metrics": {
      "get": {
        "description": "Accuracy summary and procurement buffer recommendation for the selected forecasts.",
        "operationId": "summary_metrics_api_metrics_get",
        "parameters": [
          {
            "description": "First UK delivery day, YYYY-MM-DD.",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First UK delivery day, YYYY-MM-DD.",
              "title": "Start"
            }
          },
          {
            "description": "Last UK delivery day (inclusive), YYYY-MM-DD.",
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last UK delivery day (inclusive), YYYY-MM-DD.",
              "title": "End"
            }
          },
          {
            "description": "day_ahead: latest forecast published by gate_time on D-1 (UK). horizon: latest forecast published at least horizon_h hours before each slot.",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Mode",
              "default": "day_ahead",
              "description": "day_ahead: latest forecast published by gate_time on D-1 (UK). horizon: latest forecast published at least horizon_h hours before each slot."
            }
          },
          {
            "description": "Hours between publish and slot start. Required when mode=horizon.",
            "in": "query",
            "name": "horizon_h",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 48.0,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Hours between publish and slot start. Required when mode=horizon.",
              "title": "Horizon H"
            }
          },
          {
            "description": "Day-ahead decision gate, Europe/London wall-clock time, HH:MM.",
            "in": "query",
            "name": "gate_time",
            "required": false,
            "schema": {
              "default": "09:00:00",
              "description": "Day-ahead decision gate, Europe/London wall-clock time, HH:MM.",
              "format": "time",
              "title": "Gate Time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Summary Metrics"
      }
    },
    "/api/metrics/by-horizon": {
      "get": {
        "description": "Lead-time decay curve: horizon mode re-run for H = 1..48 h.",
        "operationId": "by_horizon_api_metrics_by_horizon_get",
