{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{backend/app/**,data/manifest.json,data/*.csv.gz}",
      "excludeFiles": "{frontend/**,backend/tests/**,backend/.venv/**,data/*.parquet,docs/**,scripts/**,**/__pycache__/**,**/node_modules/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
