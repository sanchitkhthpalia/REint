{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,data/**}",
      "excludeFiles": "{backend/tests/**,backend/.venv/**,**/__pycache__/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
